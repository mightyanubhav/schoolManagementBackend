PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/school

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES=7d

# Local demo setup: TEST=true and set a private TEST_PASSWORD (12+ characters).
# Production requires TEST=false and an initial administrator only when the database is empty.
TEST=false
TEST_PASSWORD=

# In production, set this to true and provide HTTPS CLIENT_ORIGIN values.
DEPLOYMENT=false

CLIENT_ORIGIN=http://localhost:5173

# Required only when bootstrapping an empty database. Remove these after setup.
INITIAL_ADMIN_NAME=School Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible; use an R2 API token with Object Read & Write)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Optional: defaults to https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# SMTP (optional – if unset, emails print to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School <noreply@school.local>"